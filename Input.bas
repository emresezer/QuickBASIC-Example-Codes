' QuickBASIC - Sum of five numbers

' Declare variables
DIM a AS DOUBLE
DIM b AS DOUBLE
DIM c AS DOUBLE
DIM d AS DOUBLE
DIM e AS DOUBLE
DIM total AS DOUBLE

' Read numbers from user
PRINT "Enter the first number:"
INPUT a

PRINT "Enter the second number:"
INPUT b

PRINT "Enter the third number:"
INPUT c

PRINT "Enter the fourth number:"
INPUT d

PRINT "Enter the fifth number:"
INPUT e

' Calculate the sum
total = a + b + c + d + e

' Print the result
PRINT "The sum of the numbers is: "; total
