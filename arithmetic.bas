' QuickBASIC - Basic arithmetic operations and string example

' Declare numeric variables
DIM a AS INTEGER
DIM b AS INTEGER
DIM c AS INTEGER
DIM d AS INTEGER
DIM e AS INTEGER

' Initialize variables
a = 2
b = 4
c = 3
d = 9
e = 15

' Basic arithmetic operations
PRINT "a + b ="; a + b
PRINT "a - b ="; a - b
PRINT "b * c ="; b * c
PRINT "d / c ="; d / c

' Combined text and calculation
PRINT "The sum of"; a; "and"; b; "is"; a + b

' String variable example
DIM a$ AS STRING
a$ = "2"
PRINT "String value of a$: "; a$
